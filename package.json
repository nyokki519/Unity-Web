{
  "name": "unity-mix",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Unity's real-time conversation game: 遊ぶほど、その人が見えてくる。",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test test/*.test.js",
    "check:questions": "node tools/check-questions.js",
    "vendor:three": "node tools/vendor-three.js",
    "test:abyss": "node --test test/abyss-*.test.js",
    "vendor:physics": "node tools/vendor-physics.js"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "earcut": "3.2.4",
    "qrcode": "1.5.4",
    "three": "0.180.0",
    "ws": "8.22.0"
  }
}
